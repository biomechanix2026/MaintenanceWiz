# Copy to .env (or export in your shell) to enable LLM mode.
# Without this key the system runs in deterministic mode (fully functional).
ANTHROPIC_API_KEY=replace-with-anthropic-api-key

# Hosted-demo build (web/): free AI Studio key, https://aistudio.google.com/apikey
GEMINI_API_KEY=replace-with-gemini-api-key
